# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finanzas
DB_USER=usuario
DB_PASSWORD=cambiar
DB_SCHEMA=transacciones

# Crear tablas al arrancar (dejar en False cuando se use Alembic)
DB_CREATE_ALL=False
DB_ECHO=False

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=
DEBUG=True

# CORS (separar por comas, * para permitir todo)
CORS_ORIGINS=*

# Seguridad
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
